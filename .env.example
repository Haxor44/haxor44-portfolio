# ---------- App ----------
APP_ENV=development
PORT=3000

# ---------- Database ----------
# Used directly by the app (gorm) and matches the docker-compose postgres service.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# ---------- Contact form email (optional) ----------
# If left blank, contact messages are still saved to the database but no
# email notification is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=

# ---------- Medium sync (optional) ----------
# If set, the server pulls your latest Medium stories (RSS, last 10) into the
# articles table on start-up and then every MEDIUM_SYNC_INTERVAL.
MEDIUM_USERNAME=
MEDIUM_SYNC_INTERVAL=6h

# ---------- Auth (not implemented yet) ----------
# Once you build the admin API (see JWT_ADMIN_API_GUIDE.md), you'll add:
#   JWT_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 32
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD=change-me
